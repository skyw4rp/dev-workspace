# WebPay placeholder settings for E2E (Phase 6).
# Load when starting the backend for Playwright, e.g.:
#   PowerShell:
#     Get-Content e2e-webpay.env | ForEach-Object {
#       if ($_ -match '^([^#=]+)=(.*)$') { Set-Item -Path "env:$($matches[1])" -Value $matches[2] }
#     }
#     cd ..\backend; py run.py
PAYMENT_PROVIDER_MODE=webpay_placeholder
WEBPAY_CALLBACK_SECRET=e2e-webpay-callback-secret
WEBPAY_RETURN_URL_BASE=http://localhost:3000/orders
